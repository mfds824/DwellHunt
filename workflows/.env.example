# Gateway doPost reads p.gatewaySecret and compares it to Script Property GATEWAY_SECRET.
# Enter the existing secret locally; do not commit it or put it in frontend code.
APPS_SCRIPT_AUTH_BODY_JSON={"gatewaySecret":"<value of Apps Script Script Property GATEWAY_SECRET>"}
# The gateway authenticates from the JSON body; no auth header is required.
APPS_SCRIPT_AUTH_HEADERS_JSON={}
GOOGLE_SHEET_ID=
GOOGLE_CRM_SHEET_NAME=
